{
  "name": "worship-music-companion",
  "version": "0.1.0",
  "description": "Worship Music Companion — Chord Charts, Tuner, Setlists, Live Sync & Practice Audio",
  "author": "Worshipy Team",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --experimental-https --experimental-https-key ./certificates/localhost.key --experimental-https-cert ./certificates/localhost.crt",
    "dev:http": "next dev -H 0.0.0.0",
    "build": "next build",
    "build:standalone": "next build && node scripts/prepare-standalone.js",
    "electron:dev": "node electron/dev.js",
    "electron:build:win": "npm run build:standalone && electron-builder --win --x64",
    "electron:build:mac": "npm run build:standalone && electron-builder --mac dmg",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/lib/music/__tests__/transposition.test.ts src/lib/music/__tests__/chordDiagrams.test.ts src/lib/live/__tests__/liveSync.test.ts src/lib/tuner/__tests__/tuner.test.ts src/lib/chordpro/__tests__/chordPro.test.ts src/lib/speech/__tests__/speechSearch.test.ts src/lib/setlists/__tests__/dragReorder.test.ts src/lib/audio/__tests__/soundEngine.test.ts src/lib/audio/__tests__/practiceAudio.test.ts src/lib/cloud/__tests__/cloudAuth.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.worshipy.app",
    "productName": "Worshipy",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      ".next/standalone/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Worshipy"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.music"
    }
  }
}
